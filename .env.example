# Postgres (used by docker-compose.yml). Change these before first deploy —
# the `app`/`migrate` services build DATABASE_URL from these plus the
# in-network `db` hostname, so you don't need to edit DATABASE_URL yourself
# when running via docker compose.
POSTGRES_USER=sopm
POSTGRES_PASSWORD=sopm
POSTGRES_DB=sopm

# Only used when running `npm run dev` / `prisma` commands directly on your
# machine, outside docker compose (which builds its own DATABASE_URL from
# the POSTGRES_* vars above, pointed at the `db` service instead of
# localhost:5433).
DATABASE_URL="postgresql://sopm:sopm@localhost:5433/sopm?schema=public"

# Auth.js
AUTH_SECRET="replace-with-output-of-openssl-rand-base64-33"
# Local dev: http://localhost:3000
# Production (this repo's docker-compose + Caddyfile, IP-only, self-signed
# cert): https://<server-ip>
AUTH_URL="http://localhost:3000"

# Where uploaded SOP/reference/safety files are stored on disk (outside public/)
UPLOADS_DIR="./uploads"

# Initial accounts created by `prisma/seed.ts` (change these, then rotate the passwords after
# first login). Names predate the Admin/User permission-toggle model — SEED_EMPLOYEE_PASSWORD
# seeds the "admin" account, SEED_STUDENT_PASSWORD seeds a "student" User account with full
# content permissions (SOPs/reference/safety materials) but no user-management access.
SEED_EMPLOYEE_PASSWORD="changeme-employee"
SEED_STUDENT_PASSWORD="changeme-student"
