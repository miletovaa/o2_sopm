# Postgres (used by docker-compose.yml for local dev)
POSTGRES_USER=sopm
POSTGRES_PASSWORD=sopm
POSTGRES_DB=sopm

# Prisma connection string
DATABASE_URL="postgresql://sopm:sopm@localhost:5433/sopm?schema=public"

# Auth.js
AUTH_SECRET="replace-with-output-of-openssl-rand-base64-33"
AUTH_URL="http://localhost:3000"

# Where uploaded SOP/reference/safety files are stored on disk (outside public/)
UPLOADS_DIR="./uploads"

# Initial accounts created by `prisma/seed.ts` (change these, then rotate the passwords after first login)
SEED_EMPLOYEE_PASSWORD="changeme-employee"
SEED_STUDENT_PASSWORD="changeme-student"
