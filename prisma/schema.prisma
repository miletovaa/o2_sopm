// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  STUDENT
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String
  role         Role         @default(STUDENT)
  createdAt    DateTime     @default(now())
  sopVersions  SopVersion[] @relation("UploadedVersions")
}

model Sop {
  id                 String               @id @default(cuid())
  title              String
  category           String?
  createdAt          DateTime             @default(now())
  versions           SopVersion[]
  referenceMaterials ReferenceMaterial[]  @relation("SopReferenceMaterials")
}

model SopVersion {
  id            String   @id @default(cuid())
  sop           Sop      @relation(fields: [sopId], references: [id], onDelete: Cascade)
  sopId         String
  versionNumber Int
  filePath      String
  extractedHtml String
  extractedText String
  changeNote    String?
  uploadedBy    User     @relation("UploadedVersions", fields: [uploadedById], references: [id])
  uploadedById  String
  uploadedAt    DateTime @default(now())

  @@unique([sopId, versionNumber])
}

model ReferenceMaterial {
  id        String   @id @default(cuid())
  title     String
  filePath  String?
  url       String?
  createdAt DateTime @default(now())
  sops      Sop[]    @relation("SopReferenceMaterials")
}

model SafetyMaterial {
  id        String   @id @default(cuid())
  title     String
  filePath  String?
  url       String?
  createdAt DateTime @default(now())
}
